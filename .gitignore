# Generated sources, builds, prefixes and private runtime state must never be committed.
/.work/
/.private/
/sources/
/build/
/build-*/
/prefix/
/install*/
/runs/
# Raw logs and local caches (curated historical excerpts use .txt).
*.log
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
__pycache__/
*.py[cod]
.venv/
venv/
# Local credentials and key stores. Never rely on ignore rules alone for secrets.
.env
.env.*
.netrc
.authinfo
.git-credentials
.npmrc
.pypirc
.ssh/
.aws/
.gnupg/
credentials.json
credentials.*.json
secrets.json
secrets.*.json
id_rsa
id_ed25519
*.pem
*.key
*.p12
*.pfx
# Compiled objects, generated package metadata and redistributable artifacts.
*.pc
*.o
*.lo
*.la
*.so
*.so.*
*.a
*.dll
*.exe
*.deb
*.rpm
*.flatpak
*.flatpakrepo
*.flatpakref
*.tar
*.tar.*
*.tgz
*.zip
